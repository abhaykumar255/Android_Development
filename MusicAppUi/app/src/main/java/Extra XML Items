<Button
weight = "match parenet"
height = "wrap content"
text="1"
id = "button 1"
onClick = "onDigit" // this is a function that will be called in activity
/>

In Activity
val updateTextView : Textview = .....
// so here button will return the view, and the property of the button
// Now we can add the if needed text to the textview
fun onDigit(view : View){
// i am just appending the text
updateTextView.append((view as Button).text)
}